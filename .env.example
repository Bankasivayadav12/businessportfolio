# ==============================================================================
# SIVA DIGITAL PRODUCTS & PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# MongoDB Connection
# Set your MongoDB Atlas or local connection string here.
# If omitted, the platform gracefully uses an in-memory high-fidelity data store.
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/siva_platform?retryWrites=true&w=majority

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Security
AUTH_SECRET=siva_super_secure_production_jwt_secret_token_2026_xyz
ADMIN_EMAIL=siva@example.com

# Payment Gateways (Stripe & Razorpay)
# Toggle between Stripe and Razorpay in checkout
STRIPE_PUBLIC_KEY=pk_test_placeholder_key
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

RAZORPAY_KEY_ID=rzp_test_placeholder_id
RAZORPAY_KEY_SECRET=rzp_secret_placeholder_secret

# Email Services (Resend / SMTP)
RESEND_API_KEY=re_placeholder_key
EMAIL_FROM=notifications@siva.dev
